# Local offline competition demo. Copy to .env; never commit real values.
APP_ENV=development
DATABASE_URL=sqlite:///./data/campus_agent.db
RAG_USE_ST=0
AGENT_LLM=0
WEB_SEARCH_PROVIDER=none
ENABLE_DEMO_LOGIN=1
DEV_ADMIN_QUICK_LOGIN=0
CORS_ALLOWED_ORIGINS=
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_SECONDS=28800
ADMIN_API_TOKEN=

# Optional model assistance: set AGENT_LLM=1 and fill your own private configuration.
AGENT_LLM_API_KEY=
AGENT_LLM_BASE_URL=
AGENT_LLM_MODEL=
AGENT_LLM_ALLOWED_MODELS=
AGENT_LLM_PROVIDER=
AGENT_LLM_TEMPERATURE=0.3
CHROMA_HOST=
CHROMA_PORT=8000
WEB_SEARCH_API_KEY=
